{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm install --prefix frontend && npm run build --prefix frontend",
  "functions": {
    "app/main.py": {
      "maxDuration": 60,
      "excludeFiles": "{frontend/node_modules/**,.venv/**,**/__pycache__/**,**/*.pyc,**/.git/**}"
    }
  }
}
