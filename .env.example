AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Web search — optional
TAVILY_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# OCR.space — https://ocr.space/ocrapi
OCR_SPACE_API_KEY=helloworld
